# ==============================================================================
# ATLAS Production Environment Configuration Template
# Copy to .env.production and populate secure values before deploying
# ==============================================================================

# Execution Environment
ATLAS_ENV=production
ATLAS_HOME=/data
ATLAS_ARTIFACTS_DIR=/data/artifacts

# Database Connection (PostgreSQL 16)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=generate_strong_password_here_min_32_chars
POSTGRES_DB=atlas_production
ATLAS_DATABASE_URL=postgresql://atlas:generate_strong_password_here_min_32_chars@atlas-postgres:5432/atlas_production

# Redis Cache & Message Bus
REDIS_PASSWORD=generate_strong_redis_password_min_32_chars
ATLAS_REDIS_URL=redis://:generate_strong_redis_password_min_32_chars@atlas-redis:6379/0

# Integration Vault Secret Encryption (Fernet key generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ATLAS_VAULT_ENCRYPTION_KEY=

# OpenTelemetry Tracing & Metrics Collection
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=atlas-production
OTEL_TRACES_SAMPLER=parentbased_always_on

# Prometheus & Grafana Monitoring
GRAFANA_ADMIN_PASSWORD=generate_strong_grafana_admin_password

# Authentication Tokens & API Keys
ATLAS_API_KEY_ADMIN=admin_production_secret_key_change_me
ATLAS_API_KEY_OPERATOR=operator_production_secret_key_change_me
ATLAS_API_KEY_WORKER=worker_production_secret_key_change_me

# Security & Network Isolation
ATLAS_BLOCK_PRIVATE_NETWORKS=true
ATLAS_ALLOW_LOCALHOST=false
ATLAS_TASK_TIMEOUT_SECONDS=300
ATLAS_MAX_QUEUE_DEPTH=500
