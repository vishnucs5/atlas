# Copy this file to deploy/cloud/.env. Never commit the copied file.
# Values below are intentionally blank; generate distinct, URL-safe values for every secret.

POSTGRES_USER=atlas
POSTGRES_PASSWORD=
POSTGRES_DB=atlas
REDIS_PASSWORD=
ATLAS_VAULT_ENCRYPTION_KEY=
ATLAS_API_KEY_ADMIN=
ATLAS_API_KEY_OPERATOR=
ATLAS_API_KEY_WORKER=
ATLAS_API_KEY_VIEWER=

# Comma-separated browser origins. Do not use a wildcard in production.
ATLAS_CORS_ORIGINS=https://atlas.example.com
ATLAS_DOMAIN=atlas.example.com

# The selected zero-cost provider credential belongs in the cloud secret manager.
# OpenRouter is required for the default openrouter/free route.
OPENROUTER_API_KEY=
