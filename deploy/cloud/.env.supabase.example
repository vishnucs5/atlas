# Copy this file to deploy/cloud/.env.supabase. Never commit the copied file.
# Get ATLAS_DATABASE_URL from Supabase Dashboard -> Connect. Use the exact URL
# shown there; percent-encode reserved password characters if required.

ATLAS_DATABASE_URL=
REDIS_PASSWORD=
ATLAS_VAULT_ENCRYPTION_KEY=
ATLAS_API_KEY_ADMIN=
ATLAS_API_KEY_OPERATOR=
ATLAS_API_KEY_WORKER=
ATLAS_API_KEY_VIEWER=
# Without a custom domain, use the VM IPv4 in sslip.io form, for example:
# ATLAS_DOMAIN=203-0-113-42.sslip.io
# ATLAS_CORS_ORIGINS=https://203-0-113-42.sslip.io
ATLAS_CORS_ORIGINS=https://atlas.example.com
ATLAS_DOMAIN=atlas.example.com
OPENROUTER_API_KEY=
