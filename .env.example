# ==============================================================================
# ATLAS Autonomous Task & Lifecycle Automation System - Production Configuration
# ==============================================================================

# --- REST API Server & Networking ---
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000
ATLAS_ENVIRONMENT=production

# --- Authentication & Role-Based Access Control (RBAC) ---
# Replace with high-entropy cryptographic tokens in production environments
ATLAS_API_KEY_ADMIN=admin-key-supersecret
ATLAS_API_KEY_OPERATOR=operator-key-supersecret
ATLAS_API_KEY_WORKER=worker-key-supersecret
ATLAS_API_KEY_VIEWER=viewer-key-supersecret

# --- Storage Engine (SQLite & PostgreSQL) ---
# For SQLite deployment:
ATLAS_DB_PATH=/data/atlas.db
# For PostgreSQL deployment:
ATLAS_DATABASE_URL=postgresql://atlas:atlas_password_production@localhost:5432/atlas_production

# --- File System, Artifacts & Quotas ---
ATLAS_HOME=/data
ATLAS_ARTIFACTS_DIR=/data/artifacts
ATLAS_MAX_ARTIFACT_SIZE_BYTES=26214400 # 25 MB

# --- Concurrency, Backpressure & Resource Caps ---
ATLAS_MAX_CONCURRENT_TASKS=50
ATLAS_MAX_QUEUE_DEPTH=100
ATLAS_TASK_TIMEOUT_SECONDS=300

# --- Network Policy & SSRF Defense ---
ATLAS_BLOCK_PRIVATE_NETWORKS=true
ATLAS_ALLOW_LOCALHOST=false
ATLAS_DEFAULT_DECISION=ALLOW
ATLAS_DEFAULT_RISK=LOW

# --- Worker Fleet Coordination ---
ATLAS_WORKER_ID=worker-node-primary
ATLAS_WORKER_CAPABILITIES=desktop,browser
ATLAS_WORKER_HEARTBEAT_INTERVAL=5.0
ATLAS_WORKER_POLL_INTERVAL=1.0

# --- Optional Model Provider API Keys ---
# Configure credentials only for required external inference providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
