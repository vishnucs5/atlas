          "max_output_tokens": 4096,
          "capabilities": ["general", "coding"],
          "pricing": {"inference_on_workers_free": 0.0},
          "eligibility_status": "FREE_VERIFIED",
          "official_verification_sources": ["https://developers.cloudflare.com/workers-ai/platform/pricing/"],
          "verification_date": "2026-11-20T00:00:00Z",
          "review_expiry": "2026-12-20T00:00:00Z",
          "privacy_disclosure": "Workers AI model inference data retention follows Cloudflare Workers AI terms.",
          "billing_and_overage_policy": "Requires CLOUDFLARE_ACCOUNT_ID and ATLAS_CLOUDFLARE_WORKERS_FREE_ATTESTED=1."
        }
      ]
    }
  }
}
